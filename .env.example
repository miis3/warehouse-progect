# Copy to .env. This file contains no usable credential.
# Find the project URL and publishable key in Supabase Dashboard > Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public legacy anon JWT, NOT a privileged key. Required by verify_jwt=true.
# Dashboard > Settings > API Keys > Legacy anon key. Keep the publishable key above.
SUPABASE_ANON_KEY=replace_with_public_legacy_anon_jwt

# Local Windows defaults: http://localhost:8080
WAREHOUSE_SITE_ADDRESS=:80
WAREHOUSE_HTTP_PORT=8080
WAREHOUSE_HTTPS_PORT=8443

# For public self-hosting, use a real DNS name and expose ports 80/443 instead:
# WAREHOUSE_SITE_ADDRESS=warehouse.example.com
# WAREHOUSE_HTTP_PORT=80
# WAREHOUSE_HTTPS_PORT=443
