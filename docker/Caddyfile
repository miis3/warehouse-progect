{
	admin off
}

{$WAREHOUSE_SITE_ADDRESS} {
	root * /srv
	encode zstd gzip

	@health path /healthz
	respond @health "ok" 200

	handle /api/warehouse {
		rewrite * /functions/v1/warehouse-api
		reverse_proxy {$SUPABASE_URL} {
			header_up Host {upstream_hostport}
			header_up -Origin
			header_up -Authorization
			header_up apikey {$SUPABASE_PUBLISHABLE_KEY}
		}
	}

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	@fresh path / /index.html /warehouse-config.js
	header @fresh Cache-Control "no-store"

	file_server
}
